{
  "name": "chordino-wasm",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run build:wasm && npm run build:js",
    "build:wasm": "bash src/build.sh",
    "build:js": "tsc -b src/js && esbuild src/js/chord-worker.ts src/js/chord-processor.ts --outdir=build --out-extension:.js=.mjs --format=esm --target=es2022 --minify",
    "test": "node --test \"test/*.test.js\""
  },
  "devDependencies": {
    "@types/audioworklet": "^0.0.100",
    "esbuild": "^0.28.2",
    "mpg123-decoder": "^1.0.3",
    "typescript": "^7.0.2"
  }
}
