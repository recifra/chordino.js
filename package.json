{
  "name": "chordino.js",
  "version": "0.2.1",
  "description": "Chord detection in the browser: the Chordino Vamp plugin, ported to C and compiled to WebAssembly, with a Web Worker for recordings and an AudioWorklet feeding a Web Worker for live input",
  "keywords": [
    "chord",
    "chords",
    "chord-detection",
    "chordino",
    "nnls-chroma",
    "vamp",
    "music",
    "audio",
    "audioworklet",
    "webassembly",
    "wasm"
  ],
  "homepage": "https://github.com/recifra/chordino.js#readme",
  "bugs": {
    "url": "https://github.com/recifra/chordino.js/issues"
  },
  "license": "GPL-2.0-or-later",
  "author": "Francimar Alves <mazinsw@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/recifra/chordino.js.git"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./build/chordino.d.mts",
      "default": "./build/chordino.mjs"
    },
    "./chord-worker.mjs": "./build/chord-worker.mjs",
    "./chord-live-worker.mjs": "./build/chord-live-worker.mjs",
    "./chord-processor.mjs": "./build/chord-processor.mjs",
    "./chordino.wasm": "./build/chordino.wasm",
    "./package.json": "./package.json"
  },
  "files": [
    "build/chordino.mjs",
    "build/chordino.wasm",
    "build/chordino.d.mts",
    "build/chord-worker.mjs",
    "build/chord-live-worker.mjs",
    "build/chord-processor.mjs",
    "src/kissfft/COPYING",
    "src/kissfft/LICENSES/BSD-3-Clause",
    "src/vamp-sdk-COPYING"
  ],
  "scripts": {
    "build": "npm run build:wasm && npm run build:js",
    "build:wasm": "bash src/build.sh",
    "build:js": "tsc -b src/js && esbuild src/js/chord-worker.ts src/js/chord-live-worker.ts src/js/chord-processor.ts --outdir=build --out-extension:.js=.mjs --format=esm --target=es2022 --minify && cp src/js/chordino.d.mts build/",
    "test": "node --test \"test/*.test.js\"",
    "prepublishOnly": "npm run build && npm test"
  },
  "devDependencies": {
    "@types/audioworklet": "^0.0.100",
    "esbuild": "^0.28.2",
    "mpg123-decoder": "^1.0.3",
    "typescript": "^7.0.2"
  }
}
